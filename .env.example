# Copy to .env and fill in. Every value is optional; defaults are shown.
# Inside the IBM Skills Network lab no API key is needed.

WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=skills-network
WATSONX_APIKEY=

LLM_MODEL_ID=ibm/granite-8b-code-instruct
EMBEDDING_MODEL_ID=ibm/slate-30m-english-rtrvr-v2
MAX_NEW_TOKENS=900

CHUNK_SIZE=200
CHUNK_OVERLAP=20
TOP_K=7
TRANSCRIPT_LANGUAGES=en

SERVER_NAME=0.0.0.0
SERVER_PORT=7860
